{
  "name": "google-genai-api",
  "version": "1.3.0",
  "description": "Node.js wrapper for the Google GenAI API: Gemini image generation and editing, video understanding, and Veo 3.1 video generation",
  "type": "module",
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "bin": {
    "google-genai": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./api": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./video": {
      "import": "./dist/video-api.js",
      "types": "./dist/video-api.d.ts"
    },
    "./veo": {
      "import": "./dist/veo-api.js",
      "types": "./dist/veo-api.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "google": "tsx src/cli.ts",
    "google:help": "tsx src/cli.ts --help",
    "google:examples": "tsx src/cli.ts --examples",
    "google:gemini": "tsx src/cli.ts --gemini",
    "google:veo": "tsx src/cli.ts --veo",
    "google:veo:fast": "tsx src/cli.ts --veo --veo-model veo-3.1-fast-generate-preview",
    "prepublishOnly": "npm run check:release",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "verify": "npm run typecheck && npm run build && npm test",
    "check:lifecycle": "tsx scripts/check-lifecycle.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "keywords": [
    "google",
    "genai",
    "gemini",
    "veo",
    "ai",
    "image-generation",
    "video-generation",
    "text-to-image",
    "text-to-video",
    "image-to-image",
    "image-to-video",
    "semantic-masking"
  ],
  "author": "img-gen Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aself101/google-genai-api.git"
  },
  "bugs": {
    "url": "https://github.com/aself101/google-genai-api/issues"
  },
  "homepage": "https://github.com/aself101/google-genai-api#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "axios": "^1.20.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "file-type": "^21.3.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
